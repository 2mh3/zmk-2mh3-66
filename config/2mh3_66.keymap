#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    // マトリックス変換（QMKのROW2COL / COL2ROWやピン定義をZMK用にマッピング）
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-composite";
        label = "KSCAN";
        data-gpios = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // 例: ダイオード方向 COL2ROW

        // 列 (Cols: F7, F6, F5, F4, D7, C6, E6 -> ProMicro互換ピン)
        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_HIGH> // F7
            , <&pro_micro 20 GPIO_ACTIVE_HIGH> // F6
            , <&pro_micro 19 GPIO_ACTIVE_HIGH> // F5
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> // F4
            , <&pro_micro 6  GPIO_ACTIVE_HIGH> // D7
            , <&pro_micro 7  GPIO_ACTIVE_HIGH> // C6
            , <&pro_micro 8  GPIO_ACTIVE_HIGH> // E6
            ;

        // 行 (Rows: B1, B2, B3, B4, B5 -> ProMicro互換ピン)
        row-gpios
            = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // B1
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // B2
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // B3
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // B4
            , <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // B5
            ;
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default Layer
        default_layer {
            bindings = <
                &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6         &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC
                &kp LSHFT  &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T          &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT
                &kp ESC    &kp LCTRL &kp A     &kp S     &kp D     &kp F     &kp G          &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp RET
                &kp GRAVE  &mo 2     &kp Z     &kp X     &kp C     &kp V     &kp B          &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp BSLH  &kp RSHFT
                &kp N0     &kp N0    &mo 1     &kp LALT  &kp LGUI  &kp SPACE &kp Y          &tog 2    &kp SPACE &kp RSHFT &kp RALT  &mo 1     &kp N0    &kp N0
            >;
        };

        // Layer 1: FN Layer (QMK Layer 1)
        fn_layer {
            bindings = <
                &trans     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6         &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &trans
                &trans     &trans    &trans    &kp UP    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans     &trans    &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans         &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans    &trans
                &trans     &trans    &trans    &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans     &trans    &trans    &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        // Layer 2: Extra / Mouse & BLE Layer (QMK Layer 2)
        // ※ZMKは標準でマウスカーソル移動に対応していないため、矢印キーやBLE設定キーに置き換えるかモジュールを追加します
        media_layer {
            bindings = <
                &trans     &kp F1       &kp F2       &kp F3       &kp F4       &kp F5    &kp F6         &kp F7     &kp F8     &kp F9     &kp F10   &kp F11   &kp F12   &trans
                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &kp UP       &bt BT_CLR   &trans    &trans         &trans     &trans     &trans     &trans    &trans    &trans    &trans
                &trans     &trans       &kp LEFT     &kp DOWN     &kp RIGHT    &trans    &trans         &kp LEFT   &trans     &trans     &kp RIGHT &trans    &trans    &trans
                &trans     &trans       &trans       &trans       &trans       &trans    &trans         &trans     &trans     &trans     &trans    &trans    &trans    &trans
                &tog 2     &trans       &trans       &trans       &trans       &trans    &trans         &tog 2     &trans     &trans     &trans    &trans    &trans    &trans
            >;
        };
    };
};