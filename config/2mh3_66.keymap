#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        // Layer 0: Default Layer
        default_layer {
            bindings = <
                &kp ESC    &kp N1     &kp N2        &kp N3        &kp N4        &kp N5        &kp N6         &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS  &kp EQUAL  &kp BSPC
                &kp LSHFT  &kp TAB    &kp Q         &kp W         &kp E         &kp R         &kp T          &kp Y         &kp U         &kp I         &kp O         &kp P       &kp LBKT   &kp RBKT
                &kp ESC    &kp LCTRL  &kp A         &kp S         &kp D         &kp F         &kp G          &kp H         &kp J         &kp K         &kp L         &kp SEMI   &kp SQT    &kp RET
                &kp GRAVE  &mo 2      &kp Z         &kp X         &kp C         &kp V         &kp B          &kp N         &kp M         &kp COMMA    &kp DOT      &kp FSLH   &kp BSLH   &kp RSHFT
                &kp N0     &kp N0     &mo 1        &kp LALT       &kp LGUI       &kp SPACE      &kp Y            &tog 2       &kp SPACE    &kp RSHFT     &kp RALT     &mo 1      &kp N0     &kp N0
            >;
        };

        // Layer 1: FN Layer (QMK Layer 1)
        fn_layer {
                &trans     &kp F1       &kp F2     &kp F3     &kp F4     &kp F5     &kp F6          &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12      &trans
                &trans     &trans       &trans     &kp UP     &trans     &trans     &bt BT_CLR      &trans     &trans     &trans     &trans     &trans     &trans       &trans
                &trans     &trans       &kp LEFT   &kp DOWN   &kp RIGHT  &trans     &bt BT_SEL 0    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans     &trans       &trans
                &kp N1     &bootloader  &trans     &trans     &trans     &trans     &bt BT_SEL 1    &trans     &trans     &trans     &trans     &trans     &bootloader  &trans
                &kp N1     &trans       &trans     &trans     &trans     &trans     &trans          &trans     &trans     &trans     &trans     &trans     &trans       &trans
            >;
        };

        // Layer 2: Mouse & BLE Layer (QMK Layer 2)
        media_layer {
            bindings = <
                &trans  &kp F1    &kp F2         &kp F3          &kp F4          &kp F5          &kp F6                      &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &trans
                &trans  &trans    &mkp MB1       &mmv MOVE_UP    &mkp MB2        &trans          &trans                      &msc SCRL_RIGHT &msc SCRL_DOWN  &msc SCRL_LEFT  &trans          &trans          &trans          &trans
                &kp N0  &trans    &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT &trans          &trans                &kp LEFT        &mkp MB1        &mkp MB2        &kp RIGHT       &trans          &trans          &trans
                &kp N2  &trans    &trans         &trans          &trans          &trans          &trans                      &trans          &msc SCRL_UP    &trans          &trans          &trans          &trans          &trans
                &kp N2  &trans    &trans         &trans          &trans          &trans          &trans                      &tog 2          &mkp MB2        &trans          &trans          &trans          &trans          &trans
            >;
        };
    };
};